export org.babyfish.jimmer.sql.model.generic.GenericTreeNode

IdViewNodeView {
    id
    !orderBy(parentKey desc)
    !where(parentKey is not null)
    children {
        id
    }
}

SyntheticIdViewNodeView {
    id
    !orderBy(parentId asc)
    !where(parentId is not null)
    children {
        id
    }
}
