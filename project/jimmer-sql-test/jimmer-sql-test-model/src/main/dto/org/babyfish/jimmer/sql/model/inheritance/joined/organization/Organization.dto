/*
 * Organization 的 polymorphic DTO (joined 继承)。
 *
 * 3 个变种共用同一种 per-layer inner DTO 布局:
 *   - 根级 inner DTO 嵌套在 outer (TargetOf_director / TargetOf_address)
 *   - 分支专属 inner DTO 嵌套在每个 branch 类
 *     (TargetOf_departments / TargetOf_manager)
 *   - 2-level 路径: director -> officeAddress (根级)
 *                   departments -> manager (per-branch)
 *
 * 三个变种走的是 DtoGenerator.generatePolymorphic() 同一份代码,所以
 * trimmed 修复对三者同时生效 — View 用来投影,Input 用来 toEntity 转换,
 * Spec 用来拼查询条件。
 */
OrganizationOverview {
    id
    name
    #types {
        #exhaustive
        Company {
            shareCount
            director {
                id
                fullName
                officeAddress {
                    id
                    street
                    city
                }
            }
            departments {
                id
                name
                manager {
                    id
                    fullName
                    level
                }
            }
        }
        GovernmentAgency {
            budget
            director {
                id
                fullName
                officeAddress {
                    id
                    street
                    city
                }
            }
            departments {
                id
                name
                manager {
                    id
                    fullName
                    level
                }
            }
        }
    }
}

input OrganizationInput {
    id
    name
    #types {
        #exhaustive
        Company {
            shareCount
            director {
                id
                fullName
                officeAddress {
                    id
                    street
                    city
                }
            }
            departments {
                id
                name
                manager {
                    id
                    fullName
                    level
                }
            }
        }
        GovernmentAgency {
            budget
            director {
                id
                fullName
                officeAddress {
                    id
                    street
                    city
                }
            }
            departments {
                id
                name
                manager {
                    id
                    fullName
                    level
                }
            }
        }
    }
}

